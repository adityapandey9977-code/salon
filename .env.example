# API Gateway & Port Config
NODE_ENV=production
PORT=3030
GATEWAY_PORT=3030
API_GATEWAY_PORT=3030

# Identity Service Config
IDENTITY_SERVICE_PORT=6001
IDENTITY_SERVICE_URL="http://localhost:6001"

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10

# Logical PostgreSQL Databases (Neon / PostgreSQL)
IDENTITY_DATABASE_URL="postgresql://user:password@host/identity_db?sslmode=require"
ORGANIZATION_DATABASE_URL="postgresql://user:password@host/organization_db?sslmode=require"
PEOPLE_DATABASE_URL="postgresql://user:password@host/people_db?sslmode=require"
CUSTOMER_DATABASE_URL="postgresql://user:password@host/customer_db?sslmode=require"
BOOKING_DATABASE_URL="postgresql://user:password@host/booking_db?sslmode=require"
COMMERCE_DATABASE_URL="postgresql://user:password@host/commerce_db?sslmode=require"
PAYMENT_DATABASE_URL="postgresql://user:password@host/payment_db?sslmode=require"
INVENTORY_DATABASE_URL="postgresql://user:password@host/inventory_db?sslmode=require"
FINANCE_DATABASE_URL="postgresql://user:password@host/finance_db?sslmode=require"
COMMUNICATION_DATABASE_URL="postgresql://user:password@host/communication_db?sslmode=require"
PLATFORM_DATABASE_URL="postgresql://user:password@host/platform_db?sslmode=require"
REPORTING_DATABASE_URL="postgresql://user:password@host/reporting_db?sslmode=require"
DATABASE_URL="postgresql://user:password@host/identity_db?sslmode=require"

# Infrastructure: Upstash Redis & CloudAMQP RabbitMQ
REDIS_URL="rediss://default:token@host:6379"
RABBITMQ_URL="amqps://user:password@host/vhost"

# Redis Cache TTLs (Seconds)
USER_PROFILE_CACHE_TTL=300
USER_PERMISSION_CACHE_TTL=60
USER_ROLE_CACHE_TTL=60
USER_SCOPE_CACHE_TTL=60
SESSION_CACHE_TTL=60

# Security & JWT Tokens
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long_key"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
SERVICE_INTERNAL_SECRET="your_service_internal_secret_key_32chars"

# Service Ports
ORGANIZATION_SERVICE_PORT=6002
PEOPLE_SERVICE_PORT=6003
CUSTOMER_SERVICE_PORT=6004
BOOKING_SERVICE_PORT=6005
COMMERCE_SERVICE_PORT=6006
PAYMENT_SERVICE_PORT=6007
INVENTORY_SERVICE_PORT=6008
FINANCE_SERVICE_PORT=6009
COMMUNICATION_SERVICE_PORT=6010
PLATFORM_SERVICE_PORT=6011
REPORTING_SERVICE_PORT=6012

# Downstream Microservices URLs
ORGANIZATION_SERVICE_URL="http://localhost:6002"
PEOPLE_SERVICE_URL="http://localhost:6003"
CUSTOMER_SERVICE_URL="http://localhost:6004"
BOOKING_SERVICE_URL="http://localhost:6005"
COMMERCE_SERVICE_URL="http://localhost:6006"
PAYMENT_SERVICE_URL="http://localhost:6007"
INVENTORY_SERVICE_URL="http://localhost:6008"
FINANCE_SERVICE_URL="http://localhost:6009"
COMMUNICATION_SERVICE_URL="http://localhost:6010"
PLATFORM_SERVICE_URL="http://localhost:6011"
REPORTING_SERVICE_URL="http://localhost:6012"

# Cloudinary & Third Parties
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend Web App Config
VITE_API_URL=http://localhost:3030/api/v1
VITE_API_GATEWAY_URL=http://localhost:3030
