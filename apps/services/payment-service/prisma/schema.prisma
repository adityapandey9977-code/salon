datasource db {
  provider = "postgresql"
  url      = env("PAYMENT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated-client"
}

enum PaymentPurpose {
  BOOKING_DEPOSIT
  INVOICE_PAYMENT
  MEMBERSHIP
  PACKAGE
  WALLET_TOPUP
  FRANCHISE_SETTLEMENT
  OTHER
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  PAYMENT_LINK
  WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

model PaymentIntent {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  purpose          PaymentPurpose      @default(INVOICE_PAYMENT)
  referenceType    String?             @map("reference_type") // INVOICE, APPOINTMENT, MEMBERSHIP, PACKAGE, WALLET
  referenceId      String?             @map("reference_id") @db.Uuid
  customerId       String?             @map("customer_id") @db.Uuid // Ref to customer-service
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("INR")
  status           PaymentIntentStatus @default(CREATED)
  provider         String?             @default("MOCK")
  providerIntentId String?             @map("provider_intent_id")
  idempotencyKey   String              @unique @map("idempotency_key")
  expiresAt        DateTime?           @map("expires_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  transactions     PaymentTransaction[]
  paymentLinks     PaymentLink[]

  @@index([tenantId])
  @@index([tenantId, referenceId])
  @@index([tenantId, customerId])
  @@map("payment_intents")
}

model PaymentTransaction {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  paymentIntentId         String        @map("payment_intent_id") @db.Uuid
  method                  PaymentMethod @default(CARD)
  amount                  Decimal       @db.Decimal(12, 2)
  currency                String        @default("INR")
  status                  PaymentStatus @default(PENDING)
  provider                String        @default("MOCK")
  providerTransactionId   String?       @map("provider_transaction_id")
  providerOrderId         String?       @map("provider_order_id")
  gatewayPayloadReference String?       @map("gateway_payload_reference")
  paidAt                  DateTime?     @map("paid_at")
  failedAt                DateTime?     @map("failed_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  intent                  PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  refunds                 Refund[]

  @@index([tenantId])
  @@index([paymentIntentId])
  @@map("payment_transactions")
}

model Refund {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String             @map("tenant_id") @db.Uuid
  paymentTransactionId   String             @map("payment_transaction_id") @db.Uuid
  amount                 Decimal            @db.Decimal(12, 2)
  reason                 String
  status                 RefundStatus       @default(COMPLETED)
  providerRefundId       String?            @map("provider_refund_id")
  requestedByPrincipalType String           @default("USER") @map("requested_by_principal_type")
  requestedByUserId      String?            @map("requested_by_user_id") @db.Uuid
  requestedAt            DateTime           @default(now()) @map("requested_at")
  processedAt            DateTime?          @map("processed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  transaction            PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentTransactionId])
  @@map("refunds")
}

model PaymentLink {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  paymentIntentId String        @map("payment_intent_id") @db.Uuid
  url             String
  shortUrl        String        @unique @map("short_url")
  expiresAt       DateTime      @map("expires_at")
  isPaid          Boolean       @default(false) @map("is_paid")
  createdAt       DateTime      @default(now()) @map("created_at")

  intent          PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentIntentId])
  @@map("payment_links")
}

model ProviderWebhookEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  providerEventId   String    @unique @map("provider_event_id")
  eventType         String    @map("event_type")
  signatureVerified Boolean   @default(false) @map("signature_verified")
  receivedAt        DateTime  @default(now()) @map("received_at")
  processedAt       DateTime? @map("processed_at")
  status            String    @default("PROCESSED") // RECEIVED, PROCESSED, FAILED, DUPLICATE
  error             String?
  payload           Json?

  @@map("provider_webhook_events")
}

model SettlementReconciliation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  provider       String
  settlementDate DateTime @map("settlement_date") @db.Date
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  feeAmount      Decimal  @default(0.0) @map("fee_amount") @db.Decimal(10, 2)
  taxAmount      Decimal  @default(0.0) @map("tax_amount") @db.Decimal(10, 2)
  netAmount      Decimal  @map("net_amount") @db.Decimal(12, 2)
  status         String   @default("RECONCILED") // RECONCILED, DISCREPANCY
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("settlement_reconciliations")
}
