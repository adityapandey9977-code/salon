datasource db {
  provider = "postgresql"
  url      = env("COMMERCE_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated-client"
}

enum ItemType {
  SERVICE
  PRODUCT
  PACKAGE
  MEMBERSHIP
}

enum InvoiceStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
  REFUND
  TOPUP
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSE
}

model ServiceCategory {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  name        String
  code        String
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  imageUrl    String?         @map("image_url")
  accentColor String?         @map("accent_color")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  services    ServiceMaster[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("service_categories")
}

model ServiceMaster {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  categoryId           String               @map("category_id") @db.Uuid
  code                 String
  name                 String
  description          String?
  durationMinutes      Int                  @map("duration_minutes")
  bufferBeforeMinutes  Int                  @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes   Int                  @default(0) @map("buffer_after_minutes")
  basePrice            Decimal              @map("base_price") @db.Decimal(10, 2)
  gstRate              Decimal              @default(18.0) @map("gst_rate") @db.Decimal(5, 2)
  taxCode              String?              @map("tax_code")
  sacCode              String?              @map("sac_code")
  requiresConsultation Boolean              @default(false) @map("requires_consultation")
  requiresPatchTest    Boolean              @default(false) @map("requires_patch_test")
  isActive             Boolean              @default(true) @map("is_active")
  isBookableOnline     Boolean              @default(true) @map("is_bookable_online")
  imageUrl             String?              @map("image_url")
  requiredSkill        String?              @map("required_skill")
  requiredLevel        String?              @map("required_level")
  requiredRoomOrChair  String?              @map("required_room_or_chair")
  requiredEquipment    String?              @map("required_equipment")
  pricingMode          String?              @default("Shared price across branches") @map("pricing_mode")
  discountEligible     Boolean              @default(true) @map("discount_eligible")
  availableBranches    String[]             @default([]) @map("available_branches")
  metadata             Json?                @default("{}")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  deletedAt            DateTime?            @map("deleted_at")

  category             ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  branchPrices         ServiceBranchPrice[]
  recipeBom            ServiceRecipeBom?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("service_masters")
}

model ServiceBranchPrice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  serviceId     String        @map("service_id") @db.Uuid
  branchId      String        @map("branch_id") @db.Uuid // Ref to organization-service
  price         Decimal       @db.Decimal(10, 2)
  effectiveFrom DateTime?     @map("effective_from")
  effectiveTo   DateTime?     @map("effective_to")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  service       ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, serviceId])
  @@index([tenantId, branchId])
  @@map("service_branch_prices")
}

model ServiceRecipeBom {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  serviceId   String           @unique @map("service_id") @db.Uuid
  name        String?
  description String?
  version     Int              @default(1)
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  service     ServiceMaster    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  items       ServiceBomItem[]

  @@index([tenantId])
  @@map("service_recipe_boms")
}

model ServiceBomItem {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  bomId            String           @map("bom_id") @db.Uuid
  skuId            String           @map("sku_id") @db.Uuid // Ref to inventory-service
  quantityRequired Decimal          @map("quantity_required") @db.Decimal(8, 3)
  unit             String           @default("ML")

  bom              ServiceRecipeBom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_bom_items")
}

model PackageMaster {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  code         String
  name         String
  description          String?
  price                Decimal           @db.Decimal(10, 2)
  validityDays         Int               @default(365) @map("validity_days")
  isShared             Boolean           @default(false) @map("is_shared")
  isActive             Boolean           @default(true) @map("is_active")
  durationMins         Int?              @map("duration_mins")
  salesCount           Int               @default(0) @map("sales_count")
  imageUrl             String?           @map("image_url")
  includedServicesText String?           @map("included_services_text")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  items        PackageItem[]
  customerPkgs CustomerPackage[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("package_masters")
}

model PackageItem {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  packageId        String        @map("package_id") @db.Uuid
  serviceId        String        @map("service_id") @db.Uuid
  includedQuantity Int           @map("included_quantity")

  package          PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, serviceId])
  @@map("package_items")
}

model CustomerPackage {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  customerId        String              @map("customer_id") @db.Uuid // Ref to customer-service
  packageId         String              @map("package_id") @db.Uuid
  purchaseInvoiceId String?             @map("purchase_invoice_id") @db.Uuid
  startsAt          DateTime            @default(now()) @map("starts_at")
  expiresAt         DateTime            @map("expires_at")
  status            String              @default("ACTIVE") // ACTIVE, EXPIRED, EXHAUSTED
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  package           PackageMaster       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  redemptions       PackageRedemption[]

  @@index([tenantId, customerId])
  @@map("customer_packages")
}

model PackageRedemption {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  customerPackageId String          @map("customer_package_id") @db.Uuid
  serviceId         String          @map("service_id") @db.Uuid
  appointmentId     String?         @map("appointment_id") @db.Uuid
  quantity          Int             @default(1)
  redeemedAt        DateTime        @default(now()) @map("redeemed_at")

  customerPackage   CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerPackageId])
  @@map("package_redemptions")
}

model MembershipMaster {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  name               String
  description        String?
  price              Decimal              @db.Decimal(10, 2)
  billingPeriod      String               @default("ANNUAL") @map("billing_period")
  discountPercentage Decimal              @default(0.0) @map("discount_percentage") @db.Decimal(5, 2)
  benefitsJson       Json?                @map("benefits_json")
  isActive           Boolean              @default(true) @map("is_active")
  pointsMultiplier   Decimal?             @map("points_multiplier") @db.Decimal(5, 2)
  membersCount       Int                  @default(0) @map("members_count")
  perksText          String?              @map("perks_text")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  memberships        CustomerMembership[]

  @@index([tenantId])
  @@map("membership_masters")
}

model CustomerMembership {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  customerId       String           @map("customer_id") @db.Uuid // Ref to customer-service
  membershipPlanId String           @map("membership_plan_id") @db.Uuid
  startsAt         DateTime         @default(now()) @map("starts_at")
  expiresAt        DateTime?        @map("expires_at")
  status           String           @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  membership       MembershipMaster @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId])
  @@map("customer_memberships")
}

model CustomerWallet {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  customerId     String              @unique @map("customer_id") @db.Uuid // Ref to customer-service
  currency       String              @default("INR")
  currentBalance Decimal             @default(0.0) @map("current_balance") @db.Decimal(12, 2)
  updatedAt      DateTime            @updatedAt @map("updated_at")

  transactions   WalletTransaction[]

  @@index([tenantId])
  @@map("customer_wallets")
}

model WalletTransaction {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  amount        Decimal               @db.Decimal(12, 2)
  type          WalletTransactionType
  referenceType String?               @map("reference_type") // INVOICE, TOP_UP, REFUND
  referenceId   String?               @map("reference_id") @db.Uuid
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  createdAt     DateTime              @default(now()) @map("created_at")

  wallet        CustomerWallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId, walletId])
  @@map("wallet_transactions")
}

model CustomerLoyalty {
  id                      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String               @map("tenant_id") @db.Uuid
  customerId              String               @unique @map("customer_id") @db.Uuid // Ref to customer-service
  pointsBalanceProjection Int                  @default(0) @map("points_balance_projection")
  tier                    String               @default("SILVER")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  transactions            LoyaltyTransaction[]

  @@index([tenantId])
  @@map("customer_loyalties")
}

model LoyaltyTransaction {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  loyaltyId   String                 @map("loyalty_id") @db.Uuid
  points      Int
  type        LoyaltyTransactionType
  referenceType String?              @map("reference_type")
  referenceId String?                @map("reference_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")

  loyalty     CustomerLoyalty        @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)

  @@index([tenantId, loyaltyId])
  @@map("loyalty_transactions")
}

model CouponMaster {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderValue Decimal      @default(0.0) @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount   Decimal?     @map("max_discount") @db.Decimal(10, 2)
  expiresAt     DateTime?    @map("expires_at")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("coupon_masters")
}

model Invoice {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  branchId       String            @map("branch_id") @db.Uuid // Ref to organization-service
  customerId     String?           @map("customer_id") @db.Uuid // Ref to customer-service
  appointmentId  String?           @map("appointment_id") @db.Uuid // Ref to booking-service
  invoiceNumber  String            @unique @map("invoice_number")
  subtotal       Decimal           @db.Decimal(12, 2)
  discountTotal  Decimal           @default(0.0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal       Decimal           @default(0.0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal     Decimal           @map("grand_total") @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0.0) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue     Decimal           @default(0.0) @map("balance_due") @db.Decimal(12, 2)
  status         InvoiceStatus     @default(PENDING_PAYMENT)
  issuedAt       DateTime          @default(now()) @map("issued_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  items          InvoiceLineItem[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([tenantId, customerId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  itemType       ItemType @map("item_type")
  itemId         String   @map("item_id") @db.Uuid
  skuId          String?  @map("sku_id") @db.Uuid // Ref to inventory-service
  staffId        String?  @map("staff_id") @db.Uuid // Ref to people-service
  description    String?
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.0) @map("discount_amount") @db.Decimal(10, 2)
  taxRate        Decimal  @default(18.0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0.0) @map("tax_amount") @db.Decimal(10, 2)
  lineTotal      Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}
