NODE_ENV=development
PORT=6001
IDENTITY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/identity_db?schema=public&connection_limit=10&pool_timeout=10"
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10

REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=5
REDIS_RECONNECT_DELAY=500

JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long_key"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

SERVICE_INTERNAL_SECRET="your_service_internal_secret_key_32chars"

# Cache TTLs in Seconds
USER_PROFILE_CACHE_TTL=300
USER_PERMISSION_CACHE_TTL=60
USER_ROLE_CACHE_TTL=60
USER_SCOPE_CACHE_TTL=60
SESSION_CACHE_TTL=60
MFA_CHALLENGE_CACHE_TTL=300
