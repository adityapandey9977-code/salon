datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/infrastructure/prisma/generated-client"
}

// ==========================================
// Enums
// ==========================================

enum StockMovementType {
  OPENING
  PURCHASE_RECEIPT
  SERVICE_CONSUMPTION
  RETAIL_SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_TO_SUPPLIER
  CUSTOMER_RETURN
  WASTAGE
  DAMAGE
  EXPIRY
}

enum PoStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum GoodsReceiptStatus {
  RECEIVED
  INSPECTED
  COMPLETED
  REJECTED
}

enum TransferStatus {
  DRAFT
  REQUESTED
  DISPATCHED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ADJUSTED
}

// ==========================================
// Product Category & SKU Master
// ==========================================

model InventoryCategory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  name             String
  description      String?
  parentCategoryId String?  @map("parent_category_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  skus             InventorySku[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inventory_categories")
}

model InventorySku {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  skuCode         String             @map("sku_code")
  barcode         String?
  name            String
  description     String?
  categoryId      String?            @map("category_id") @db.Uuid
  unitOfMeasure   String             @default("PIECE") @map("unit_of_measure")
  purchaseUnit    String?            @map("purchase_unit")
  consumptionUnit String?            @map("consumption_unit")
  conversionFactor Decimal?          @default(1.0) @map("conversion_factor") @db.Decimal(10, 4)
  costPrice       Decimal            @default(0.0) @map("cost_price") @db.Decimal(10, 2)
  retailPrice     Decimal?           @map("retail_price") @db.Decimal(10, 2)
  isConsumable    Boolean            @default(true) @map("is_consumable")
  isRetail        Boolean            @default(true) @map("is_retail")
  trackBatch      Boolean            @default(false) @map("track_batch")
  trackExpiry     Boolean            @default(false) @map("track_expiry")
  reorderEnabled  Boolean            @default(true) @map("reorder_enabled")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  category        InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  branchStocks    BranchStock[]
  batches         StockBatch[]
  movements       StockMovement[]
  poItems         PurchaseOrderItem[]
  grnItems        GoodsReceiptItem[]
  transferItems   StockTransferItem[]
  stocktakeItems  StocktakeItem[]
  reorderRules    ReorderRule[]

  @@unique([tenantId, skuCode])
  @@index([tenantId])
  @@map("inventory_skus")
}

// ==========================================
// Branch Stock Projection (Authoritative is StockMovement)
// ==========================================

model BranchStock {
  id                         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String       @map("tenant_id") @db.Uuid
  branchId                   String       @map("branch_id") @db.Uuid
  skuId                      String       @map("sku_id") @db.Uuid
  quantityOnHandProjection    Decimal      @default(0.0) @map("quantity_on_hand_projection") @db.Decimal(12, 3)
  quantityReservedProjection  Decimal      @default(0.0) @map("quantity_reserved_projection") @db.Decimal(12, 3)
  quantityAvailableProjection Decimal      @default(0.0) @map("quantity_available_projection") @db.Decimal(12, 3)
  reorderLevel               Int?         @default(5) @map("reorder_level")
  reorderQuantity            Int?         @default(10) @map("reorder_quantity")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  sku                        InventorySku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, skuId])
  @@index([tenantId, branchId])
  @@map("branch_stocks")
}

// ==========================================
// Stock Batch / Lot Master
// ==========================================

model StockBatch {
  id                          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String          @map("tenant_id") @db.Uuid
  branchId                    String          @map("branch_id") @db.Uuid
  skuId                       String          @map("sku_id") @db.Uuid
  batchNumber                 String          @map("batch_number")
  supplierId                  String?         @map("supplier_id") @db.Uuid
  manufacturedAt              DateTime?       @map("manufactured_at") @db.Date
  expiresAt                   DateTime?       @map("expires_at") @db.Date
  receivedQuantity            Decimal         @default(0.0) @map("received_quantity") @db.Decimal(12, 3)
  remainingQuantityProjection Decimal         @default(0.0) @map("remaining_quantity_projection") @db.Decimal(12, 3)
  unitCost                    Decimal         @default(0.0) @map("unit_cost") @db.Decimal(10, 2)
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")

  sku                         InventorySku    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  movements                   StockMovement[]

  @@unique([tenantId, branchId, skuId, batchNumber])
  @@index([tenantId, branchId])
  @@map("stock_batches")
}

// ==========================================
// Stock Movement Ledger (Append-Only & Immutable)
// ==========================================

model StockMovement {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  skuId              String            @map("sku_id") @db.Uuid
  batchId            String?           @map("batch_id") @db.Uuid
  movementType       StockMovementType @map("movement_type")
  quantity           Decimal           @db.Decimal(12, 3) // Positive for IN, Negative for OUT
  unitCost           Decimal?          @map("unit_cost") @db.Decimal(10, 2)
  referenceType      String            @map("reference_type") // PO, GRN, INVOICE, BOM, TRANSFER, ADJUSTMENT, STOCKTAKE
  referenceId        String?           @map("reference_id") @db.Uuid
  reason             String?
  occurredAt         DateTime          @default(now()) @map("occurred_at")
  actorPrincipalType String            @default("USER") @map("actor_principal_type")
  actorUserId        String?           @map("actor_user_id") @db.Uuid
  correlationId      String?           @map("correlation_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  sku                InventorySku      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  batch              StockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, skuId])
  @@index([occurredAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

// ==========================================
// Suppliers & Branch Assignments
// ==========================================

model Supplier {
  id           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String                     @map("tenant_id") @db.Uuid
  supplierCode String                     @map("supplier_code")
  legalName    String                     @map("legal_name")
  displayName  String?                    @map("display_name")
  gstin        String?
  pan          String?
  email        String?
  phone        String?
  addressLine1 String?                    @map("address_line1")
  addressLine2 String?                    @map("address_line2")
  city         String?
  state        String?
  postalCode   String?                    @map("postal_code")
  country      String?                    @default("India")
  status       String                     @default("ACTIVE")
  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

  branches     SupplierBranchAssignment[]
  orders       PurchaseOrder[]
  reorderRules ReorderRule[]

  @@unique([tenantId, supplierCode])
  @@index([tenantId])
  @@map("suppliers")
}

model SupplierBranchAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  supplierId  String   @map("supplier_id") @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  isPreferred Boolean  @default(false) @map("is_preferred")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([tenantId, supplierId, branchId])
  @@index([tenantId, branchId])
  @@map("supplier_branch_assignments")
}

// ==========================================
// Procurement: Purchase Orders & GRN
// ==========================================

model PurchaseOrder {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @map("tenant_id") @db.Uuid
  poNumber               String              @map("po_number")
  supplierId             String              @map("supplier_id") @db.Uuid
  orderingBranchId       String?             @map("ordering_branch_id") @db.Uuid
  status                 PoStatus            @default(DRAFT)
  currency               String              @default("INR")
  subtotal               Decimal             @default(0.0) @db.Decimal(12, 2)
  taxTotal               Decimal             @default(0.0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal             Decimal             @default(0.0) @map("grand_total") @db.Decimal(12, 2)
  expectedDeliveryAt     DateTime?           @map("expected_delivery_at")
  createdByPrincipalType String              @default("USER") @map("created_by_principal_type")
  createdByUserId        String?             @map("created_by_user_id") @db.Uuid
  approvedByUserId       String?             @map("approved_by_user_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  supplier               Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                  PurchaseOrderItem[]
  goodsReceipts          GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, orderingBranchId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String             @map("tenant_id") @db.Uuid
  purchaseOrderId            String             @map("purchase_order_id") @db.Uuid
  skuId                      String             @map("sku_id") @db.Uuid
  orderedQuantity            Decimal            @map("ordered_quantity") @db.Decimal(12, 3)
  receivedQuantityProjection  Decimal            @default(0.0) @map("received_quantity_projection") @db.Decimal(12, 3)
  unitPrice                  Decimal            @map("unit_price") @db.Decimal(10, 2)
  taxRate                    Decimal            @default(0.0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount                  Decimal            @default(0.0) @map("tax_amount") @db.Decimal(10, 2)
  lineTotal                  Decimal            @map("line_total") @db.Decimal(12, 2)

  purchaseOrder              PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  sku                        InventorySku       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  grnItems                   GoodsReceiptItem[]

  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  branchId              String             @map("branch_id") @db.Uuid
  purchaseOrderId       String             @map("purchase_order_id") @db.Uuid
  grnNumber             String             @map("grn_number")
  supplierInvoiceNumber String?            @map("supplier_invoice_number")
  receivedAt            DateTime           @default(now()) @map("received_at")
  receivedByUserId      String?            @map("received_by_user_id") @db.Uuid
  status                GoodsReceiptStatus @default(RECEIVED)
  createdAt             DateTime           @default(now()) @map("created_at")

  purchaseOrder         PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  items                 GoodsReceiptItem[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId, branchId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  goodsReceiptId      String             @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String?            @map("purchase_order_item_id") @db.Uuid
  skuId               String             @map("sku_id") @db.Uuid
  batchNumber         String?            @map("batch_number")
  expiryDate          DateTime?          @map("expiry_date") @db.Date
  receivedQuantity    Decimal            @map("received_quantity") @db.Decimal(12, 3)
  acceptedQuantity    Decimal            @map("accepted_quantity") @db.Decimal(12, 3)
  rejectedQuantity    Decimal            @default(0.0) @map("rejected_quantity") @db.Decimal(12, 3)
  unitCost            Decimal            @map("unit_cost") @db.Decimal(10, 2)

  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  sku                 InventorySku       @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("goods_receipt_items")
}

// ==========================================
// Inter-branch Stock Transfers
// ==========================================

model StockTransfer {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  transferNumber      String              @map("transfer_number")
  sourceBranchId      String              @map("source_branch_id") @db.Uuid
  destinationBranchId String              @map("destination_branch_id") @db.Uuid
  status              TransferStatus      @default(DRAFT)
  requestedAt         DateTime            @default(now()) @map("requested_at")
  dispatchedAt        DateTime?           @map("dispatched_at")
  receivedAt          DateTime?           @map("received_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  items               StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, sourceBranchId])
  @@index([tenantId, destinationBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  transferId         String        @map("transfer_id") @db.Uuid
  skuId              String        @map("sku_id") @db.Uuid
  requestedQuantity  Decimal       @map("requested_quantity") @db.Decimal(12, 3)
  dispatchedQuantity Decimal?      @map("dispatched_quantity") @db.Decimal(12, 3)
  receivedQuantity   Decimal?      @map("received_quantity") @db.Decimal(12, 3)

  transfer           StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  sku                InventorySku  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("stock_transfer_items")
}

// ==========================================
// Physical Stocktake & Audit Adjustments
// ==========================================

model Stocktake {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  branchId             String          @map("branch_id") @db.Uuid
  status               StocktakeStatus @default(IN_PROGRESS)
  startedAt            DateTime        @default(now()) @map("started_at")
  completedAt          DateTime?       @map("completed_at")
  createdByUserId      String?         @map("created_by_user_id") @db.Uuid
  notes                String?
  createdAt            DateTime        @default(now()) @map("created_at")

  items                StocktakeItem[]

  @@index([tenantId, branchId])
  @@map("stocktakes")
}

model StocktakeItem {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  stocktakeId          String       @map("stocktake_id") @db.Uuid
  skuId                String       @map("sku_id") @db.Uuid
  expectedQuantity     Decimal      @map("expected_quantity") @db.Decimal(12, 3)
  countedQuantity      Decimal      @map("counted_quantity") @db.Decimal(12, 3)
  variance             Decimal      @map("variance") @db.Decimal(12, 3)
  adjustmentMovementId String?      @map("adjustment_movement_id") @db.Uuid

  stocktake            Stocktake    @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  sku                  InventorySku @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@map("stocktake_items")
}

// ==========================================
// Automated Reorder Rules
// ==========================================

model ReorderRule {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  branchId            String       @map("branch_id") @db.Uuid
  skuId               String       @map("sku_id") @db.Uuid
  minimumLevel        Int          @default(5) @map("minimum_level")
  reorderLevel        Int          @default(10) @map("reorder_level")
  reorderQuantity     Int          @default(20) @map("reorder_quantity")
  maximumLevel        Int?         @map("maximum_level")
  preferredSupplierId String?      @map("preferred_supplier_id") @db.Uuid
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  sku                 InventorySku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  preferredSupplier   Supplier?    @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, skuId])
  @@index([tenantId, branchId])
  @@map("reorder_rules")
}
