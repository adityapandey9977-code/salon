# API Gateway & Port Config
NODE_ENV=development
PORT=3030
GATEWAY_PORT=3030
API_GATEWAY_PORT=3030

# Identity Service Config
IDENTITY_SERVICE_PORT=6001
IDENTITY_SERVICE_URL="http://localhost:6001"

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10

# Logical PostgreSQL Databases (Local single-instance multi-database setup)
IDENTITY_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/identity_db?schema=public&connection_limit=10&pool_timeout=10"
ORGANIZATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/organization_db?schema=public"
PEOPLE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/people_db?schema=public"
CUSTOMER_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/customer_db?schema=public"
BOOKING_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/booking_db?schema=public"
COMMERCE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/commerce_db?schema=public"
PAYMENT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/payment_db?schema=public"
INVENTORY_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/inventory_db?schema=public"
FINANCE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/finance_db?schema=public"
COMMUNICATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/communication_db?schema=public"
PLATFORM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/platform_db?schema=public"
REPORTING_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/reporting_db?schema=public"

# Infrastructure: Redis & RabbitMQ
REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Redis Cache TTLs (Seconds)
USER_PROFILE_CACHE_TTL=300
USER_PERMISSION_CACHE_TTL=60
USER_ROLE_CACHE_TTL=60
USER_SCOPE_CACHE_TTL=60
SESSION_CACHE_TTL=60

# Security & JWT Tokens
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long_key"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
SERVICE_INTERNAL_SECRET="your_service_internal_secret_key_32chars"
