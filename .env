PEOPLE_SERVICE_PORT=6003
CUSTOMER_SERVICE_PORT=6004
BOOKING_SERVICE_PORT=6005
COMMERCE_SERVICE_PORT=6006
PAYMENT_SERVICE_PORT=6007
INVENTORY_SERVICE_PORT=6008
FINANCE_SERVICE_PORT=6009
COMMUNICATION_SERVICE_PORT=6010
PLATFORM_SERVICE_PORT=6011
REPORTING_SERVICE_PORT=6012

# Downstream Microservices URLs
ORGANIZATION_SERVICE_URL="http://localhost:6002"
PEOPLE_SERVICE_URL="http://localhost:6003"
CUSTOMER_SERVICE_URL="http://localhost:6004"
BOOKING_SERVICE_URL="http://localhost:6005"
COMMERCE_SERVICE_URL="http://localhost:6006"
PAYMENT_SERVICE_URL="http://localhost:6007"
